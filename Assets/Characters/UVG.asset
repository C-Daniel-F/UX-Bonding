      speakerSide: 0
      hideLeftCharacter: 1
      hideRightCharacter: 1
  - sceneId: act1_intro
    sceneName: Acto 1 Intro
    music: {fileID: 8300000, guid: 6cb968124c84b474f841abe31d27e62d, type: 3}
    dialogueNodes:
    - nodeId: intro_01
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: eec78088c5f60aa4dbbb49bb74701594, type: 2}
      soundEffect: {fileID: 0}
      text: "Eres un nuevo estudiante en UVG, preparado para iniciar una nueva etapa
        de tu vida y decisiones que te cuestionaras en 50 a\xF1os."
      next:
        sceneId: act1_intro
        nodeId: intro_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: intro_02
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: eec78088c5f60aa4dbbb49bb74701594, type: 2}
      soundEffect: {fileID: 0}
      text: "Acabas de llegar al campus, \xBFqu\xE9 deber\xEDas hacer?"
      next:
        sceneId: act1_intro
        nodeId: 
      choices:
      - choiceId: Ir a Cayala
        text: Ir a Cayala
        destination:
          sceneId: act1_cayala
          nodeId: cayala_01
      - choiceId: Ir a ver la presentacion del inicio.
        text: Ir a ver la presentacion del inicio.
        destination:
          sceneId: act1_presentacion
          nodeId: presentacion_01
      - choiceId: Ir a la cafeteria
        text: Ir a la cafeteria
        destination:
          sceneId: act1_cafeteria
          nodeId: cafe_01
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
  - sceneId: act1_cayala
    sceneName: Cayala
    music: {fileID: 0}
    dialogueNodes:
    - nodeId: cayala_01
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: eec78088c5f60aa4dbbb49bb74701594, type: 2}
      soundEffect: {fileID: 0}
      text: "Mmmmmmm, Cayal\xE1 queda cerca, \xBFno?"
      next:
        sceneId: act1_cayala
        nodeId: cayala_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_02
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: eec78088c5f60aa4dbbb49bb74701594, type: 2}
      soundEffect: {fileID: 0}
      text: "Podr\xEDa dirigirme para all\xE1."
      next:
        sceneId: act1_cayala
        nodeId: cayala_03
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_03
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 8a6092f57b446864da6c5899a4ce7eda, type: 2}
      soundEffect: {fileID: 0}
      text: "Te diriges hacia tu auto, lo enciendes y te diriges para Cayal\xE1,
        encuentras algo de cola, pero llegas sin problemas."
      next:
        sceneId: act1_cayala
        nodeId: cayala_04
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_04
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 8a6092f57b446864da6c5899a4ce7eda, type: 2}
      soundEffect: {fileID: 0}
      text: "Mucho mejor que estar en la inducci\xF3n, \xA1ahora podr\xE9 ir a comprar
        todo lo que quiera!"
      next:
        sceneId: act1_cayala
        nodeId: cayala_05
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_05
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 8a6092f57b446864da6c5899a4ce7eda, type: 2}
      soundEffect: {fileID: 0}
      text: "Dicho y hecho, te gastaste hasta el \xFAltimo centavo que ten\xEDas,
        incluyendo el dinero que ten\xEDas previsto para la universidad."
      next:
        sceneId: act1_cayala
        nodeId: cayala_06
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_06
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 8a6092f57b446864da6c5899a4ce7eda, type: 2}
      soundEffect: {fileID: 0}
      text: Terminas quedandote sin dinero.
      next:
        sceneId: act1_cayala
        nodeId: cayala_07
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cayala_07
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 8a6092f57b446864da6c5899a4ce7eda, type: 2}
      soundEffect: {fileID: 0}
      text: "Eso podr\xEDa terminar muy mal\u2026 Mejor tomo otra decisi\xF3n."
      next:
        sceneId: act1_intro
        nodeId: intro_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
  - sceneId: act1_presentacion
    sceneName: Presentacion
    music: {fileID: 8300000, guid: 6cb968124c84b474f841abe31d27e62d, type: 3}
    dialogueNodes:
    - nodeId: presentacion_01
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: eec78088c5f60aa4dbbb49bb74701594, type: 2}
      soundEffect: {fileID: 0}
      text: "Parece que van a dar m\xE1s info sobre la uni, quiz\xE1 pueda aprender
        algo\u2026"
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_02
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Al instante que tomas asiento, quedas dormido. Pierdes de toda la informaci\xF3n
        importante que te dieron."
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_03
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_03
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Creo que haberte desvelado subiendo el pase de batalla no fue la mejor
        elecci\xF3n."
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_04
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_04
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Al cabo de unos minutos terminas despertando.
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_05
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_05
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Uh, \xBF\xBFya se acab\xF3??"
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_06
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_06
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Me perd\xED de todo\u2026"
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_07
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_07
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Tienes a una persona sentada al lado tuyo, parece que s\xED estuvo atenta
        a la charla y podr\xEDa ayudarte a ponerte al d\xEDa."
      next:
        sceneId: act1_presentacion
        nodeId: presentacion_08
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: presentacion_08
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Decides...
      next:
        sceneId: act1_presentacion
        nodeId: 
      choices:
      - choiceId: "Presentarse y preguntar qu\xE9 se habl\xF3 en la charla"
        text: "Presentarse y preguntar qu\xE9 se habl\xF3 en la charla"
        destination:
          sceneId: vozalta
          nodeId: vozalta_01
      - choiceId: Hablar en voz baja
        text: Hablar en voz baja
        destination:
          sceneId: vozbaja
          nodeId: vozbaja_01
      - choiceId: Pasar la oportunidad
        text: Pasar la oportunidad
        destination:
          sceneId: pasar
          nodeId: pasar_01
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
  - sceneId: vozalta
    sceneName: vozalta
    music: {fileID: 0}
    dialogueNodes:
    - nodeId: vozalta_01
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Disculpa, \xBFpudiste escuchar algo de lo que dijeron?"
      next:
        sceneId: vozalta
        nodeId: vozalta_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_02
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Oh, \xA1si!, hablaron un poco sobre los logros de la U, sobre tener
        metas, apuntar hacia la excelencia e inscribirnos a una app sobre salud."
      next:
        sceneId: vozalta
        nodeId: vozalta_03
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_03
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Aaaaah bueno, \xA1muchas gracias! Me llamo Vincent por cierto."
      next:
        sceneId: vozalta
        nodeId: vozalta_04
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_04
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Hola, amiguito, soy Mar\xEDa."
      next:
        sceneId: vozalta
        nodeId: vozalta_05
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_05
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "\xBFEn qu\xE9 carrera est\xE1s, Mar\xEDa?"
      next:
        sceneId: vozalta
        nodeId: vozalta_06
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_06
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Soy de compu, junto a mis amigos.
      next:
        sceneId: vozalta
        nodeId: vozalta_07
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_07
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Mar\xEDa se\xF1ala a los asientos al lado suyo, sus amigos te hacen
        un breve gesto de saludo."
      next:
        sceneId: vozalta
        nodeId: vozalta_08
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_08
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "T\xFA les devuelves el gesto por respeto."
      next:
        sceneId: vozalta
        nodeId: vozalta_09
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_09
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Wow, yo soy de compu.
      next:
        sceneId: vozalta
        nodeId: vozalta_10
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_10
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Uuuu, seguro compartimos un par de clases, quiz\xE1 nos encontremos
        por ah\xED."
      next:
        sceneId: vozalta
        nodeId: vozalta_11
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_11
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Es probable que as\xED sea, muchas gracias de nuevo por la informaci\xF3n."
      next:
        sceneId: vozalta
        nodeId: vozalta_12
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_12
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Dale, no hay problema.
      next:
        sceneId: vozalta
        nodeId: vozalta_13
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_13
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Al terminar la charla, te levantas de tu asiento y miras a lo lejos
        una botarga de un drag\xF3n verde."
      next:
        sceneId: vozalta
        nodeId: vozalta_14
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 1
    - nodeId: vozalta_14
      speaker: {fileID: 11400000, guid: ad1147b15306a78419a48d58587bc0dd, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: 
      next:
        sceneId: vozalta
        nodeId: vozalta_15
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_15
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "BROOO, ESE ES JACK?? Necesito una foto con \xE9l!"
      next:
        sceneId: vozalta
        nodeId: vozalta_16
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_16
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "\xBFNos sacamos una foto?"
      next:
        sceneId: vozalta
        nodeId: vozalta_17
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_17
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: La botarga levanta el pulgar y da el visto bueno.
      next:
        sceneId: vozalta
        nodeId: vozalta_18
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_18
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "De esta manera, tu d\xEDa tuvo un gran final, quiz\xE1 no conociste
        a muchas personas, pero tu confianza te ayud\xF3 a poder conocer m\xE1s gente
        y tener una foto que no se repetir\xE1."
      next:
        sceneId: act2_clase
        nodeId: act2_01
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 1
