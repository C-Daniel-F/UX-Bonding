        nodeId: cafe_04
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cafe_04
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 411509c5fc0617a44b698ab8b19934eb, type: 2}
      soundEffect: {fileID: 0}
      text: "Contin\xFAas caminando, pero el lugar realmente est\xE1 repleto de gente."
      next:
        sceneId: act1_cafeteria
        nodeId: cafe_05
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: cafe_05
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 411509c5fc0617a44b698ab8b19934eb, type: 2}
      soundEffect: {fileID: 0}
      text: "Oh\u2026 creo que no va a haber espacio por aqu\xED, aunque si vi un
        par de cosas interesantes."
      next:
