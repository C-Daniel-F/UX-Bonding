      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 411509c5fc0617a44b698ab8b19934eb, type: 2}
      soundEffect: {fileID: 0}
      text: "Pero esta fase no me dar\xE1 un lugar donde sentarme. Quiz\xE1 si regreso
