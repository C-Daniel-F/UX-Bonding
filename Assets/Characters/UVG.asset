      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
  - sceneId: vozalta
    sceneName: vozalta
    music: {fileID: 0}
    dialogueNodes:
    - nodeId: vozalta_01
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Disculpa, \xBFpudiste escuchar algo de lo que dijeron?"
      next:
        sceneId: vozalta
        nodeId: vozalta_02
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_02
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Oh, \xA1si!, hablaron un poco sobre los logros de la universidad, sobre
        tener metas, apuntar hacia la excelencia e inscribirnos a una app sobre salud."
      next:
        sceneId: vozalta
        nodeId: vozalta_03
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_03
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Aaaaah bueno, \xA1muchas gracias! Me llamo Vincent por cierto."
      next:
        sceneId: vozalta
        nodeId: vozalta_04
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_04
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Hola, amiguito, soy Mar\xEDa."
      next:
        sceneId: vozalta
        nodeId: vozalta_05
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_05
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "\xBFEn qu\xE9 carrera est\xE1s, Mar\xEDa?"
      next:
        sceneId: vozalta
        nodeId: vozalta_06
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_06
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Soy de compu, junto a mis amigos.
      next:
        sceneId: vozalta
        nodeId: vozalta_07
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_07
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Mar\xEDa se\xF1ala a los asientos al lado suyo, sus amigos te hacen
        un breve gesto de saludo."
      next:
        sceneId: vozalta
        nodeId: vozalta_08
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_08
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "T\xFA les devuelves el gesto por respeto."
      next:
        sceneId: vozalta
        nodeId: vozalta_09
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_09
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Wow, yo soy de compu.
      next:
        sceneId: vozalta
        nodeId: vozalta_10
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_10
      speaker: {fileID: 11400000, guid: 176ac1574d4d5c746a2b3db76b152179, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Uuuu, seguro compartimos un par de clases, quiz\xE1 nos encontremos
        por ah\xED."
      next:
        sceneId: vozalta
        nodeId: vozalta_11
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_11
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Es probable que as\xED sea, muchas gracias de nuevo por la informaci\xF3n."
      next:
        sceneId: vozalta
        nodeId: vozalta_12
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_12
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: Dale, no hay problema.
      next:
        sceneId: vozalta
        nodeId: vozalta_13
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_13
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "Al terminar la charla, te levantas de tu asiento y miras a lo lejos
        una botarga de un drag\xF3n verde."
      next:
        sceneId: vozalta
        nodeId: vozalta_14
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 1
    - nodeId: vozalta_14
      speaker: {fileID: 11400000, guid: ad1147b15306a78419a48d58587bc0dd, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: 
      next:
        sceneId: vozalta
        nodeId: vozalta_15
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_15
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "BROOO, ESE ES JACK?? Necesito una foto con \xE9l!"
      next:
        sceneId: vozalta
        nodeId: vozalta_16
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_16
      speaker: {fileID: 11400000, guid: 744ec87fa570be14d8cb7af3caf450f6, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "\xBFNos sacamos una foto?"
      next:
        sceneId: vozalta
        nodeId: vozalta_17
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_17
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: La botarga levanta el pulgar y da el visto bueno.
      next:
        sceneId: vozalta
        nodeId: vozalta_18
      choices: []
      speakerSide: 1
      hideLeftCharacter: 0
      hideRightCharacter: 0
    - nodeId: vozalta_18
      speaker: {fileID: 11400000, guid: 3f62b7a39a8e69d43a46cb1900aecd4b, type: 2}
      background: {fileID: 11400000, guid: 6be65f35063d21749a301ead174f8452, type: 2}
      soundEffect: {fileID: 0}
      text: "De esta manera, tu d\xEDa tuvo un gran final, quiz\xE1 no conociste
