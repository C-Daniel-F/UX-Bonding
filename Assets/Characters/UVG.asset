      background: {fileID: 11400000, guid: 411509c5fc0617a44b698ab8b19934eb, type: 2}
      soundEffect: {fileID: 0}
      text: "Decides acercarte un poco a las mesas, miras que todos est\xE1n hablando,
        comiendo una galleta de Gitane o contando que hicieron en vacaciones."
      next:
        sceneId: act1_cafeteria
        nodeId: cafe_03
      choices: []
      speakerSide: 0
      hideLeftCharacter: 0
      hideRightCharacter: 0
