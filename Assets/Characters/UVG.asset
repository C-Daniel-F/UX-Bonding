      background: {fileID: 11400000, guid: 411509c5fc0617a44b698ab8b19934eb, type: 2}
      soundEffect: {fileID: 0}
      text: "Quiz\xE1 deber\xEDa plantearme un par de metas o cosas que hacer para
        m\xED mismo. Despu\xE9s de todo, esta es una fase nueva\u2026"
